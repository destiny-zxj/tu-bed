# 应用配置
APP_NAME=tu-bed
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# MySQL 数据库配置
# 格式: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/tubed

# JWT 配置
SECRET_KEY=change-me-to-a-long-random-secret-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 文件存储配置
# 存储驱动: local (本地磁盘) 或 qiniu (七牛云对象存储), 默认 local
DRIVE=local
# 上传文件保存目录 (相对于 backend 或绝对路径)
UPLOAD_DIR=./uploads
# 允许的最大文件大小 (单位: MB)
MAX_UPLOAD_SIZE_MB=10
# 允许的文件扩展名
ALLOWED_EXTENSIONS=[".jpg",".jpeg",".png",".gif",".webp",".bmp"]
# 访问图片的公开基础 URL, 本地存储时使用, 例如 https://img.example.com
PUBLIC_BASE_URL=/uploads

# 七牛云对象存储配置 (QINIU_DOMAIN 无需结尾斜杠)
# 获取地址: https://portal.qiniu.com/developer/user/security (AK/SK)
# BUCKET 为空间名称, DOMAIN 为空间绑定的外链域名 (或七牛测试域名)
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=

# 初始管理员账号 (首次启动自动创建)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
ADMIN_EMAIL=admin@example.com
